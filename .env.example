PORT=5001
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/collab
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
GOOGLE_CLIENT_ID=
OWNER_EMAIL=
# Leave COOKIE_DOMAIN empty for separate Vercel frontend/API projects.
# A host-only API cookie works across authenticated API requests with CORS credentials.
COOKIE_DOMAIN=
CORS_ORIGINS=https://your-frontend.vercel.app
EMAIL_SERVICE=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=COLLAB <noreply@joincollab.org>
SUPPORT_EMAIL=support@joincollab.org
EMAIL_PROVIDER=resend
EMAIL_VERIFICATION_ENABLED=true
RESEND_API_KEY=your_resend_api_key_here
SENDGRID_API_KEY=
FRONTEND_URL=https://your-frontend.vercel.app
PUBLIC_API_BASE=https://your-backend.vercel.app
FILE_ACCESS_SECRET=replace_with_a_long_random_file_access_secret
BLOB_READ_WRITE_TOKEN=
SECURITY_ALERT_EMAIL=
SECURITY_ALERT_WEBHOOK=
SECURITY_ALERT_EVENTS=rate_limit,auth_failure,otp_lockout,admin_2fa_failed,weak_admin_password
SECURITY_ALERT_COOLDOWN_SECONDS=300
TWO_FACTOR_ENC_KEY=
EMAIL_CONNECTION_TIMEOUT_MS=10000
EMAIL_GREETING_TIMEOUT_MS=10000
EMAIL_SOCKET_TIMEOUT_MS=10000
EMAIL_SEND_TIMEOUT_MS=12000
# Redis (Railway usually provides REDIS_URL automatically when Redis service is added)
REDIS_URL=redis://localhost:6379
REDIS_PRIVATE_URL=
REDIS_PUBLIC_URL=
REDISHOST=
REDISPORT=6379
REDISUSER=default
REDISPASSWORD=
REDIS_CONNECT_TIMEOUT_MS=10000
